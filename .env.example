# Default starter mode. Use a strong value (16+ characters recommended).
EVE_CHAT_PASSWORD=

# lore: Vercel AI Gateway key for NL search compilation, AI columns, and
# research experiments (create at vercel.com/dashboard -> AI Gateway).
AI_GATEWAY_API_KEY=

# lore: local data backends (defaults match .local-infra ES and brew MySQL).
LORE_ES_URL=http://localhost:9200
LORE_MYSQL_URL=mysql://root@localhost:3306/lore

# Optional production mode. Configure every value in this section to switch
# from browser storage/password auth to Neon, Upstash, and Sign in with Vercel.
DATABASE_URL=
BETTER_AUTH_SECRET=
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: override the app origin for a custom production domain.
BETTER_AUTH_URL=

# Optional: enable hosted Vercel Connect integrations.
SLACK_CONNECTOR=
LINEAR_CONNECTOR=
NOTION_CONNECTOR=
SENTRY_CONNECTOR=
